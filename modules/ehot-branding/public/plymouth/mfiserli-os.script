# MfiSerli OS Plymouth Boot Script (dark glass: navy gradient + teal progress)
# Displays designer logo.png when provided; otherwise clean glass text splash.

Window.SetBackgroundTopColor(0.012, 0.043, 0.078);
Window.SetBackgroundBottomColor(0.043, 0.106, 0.153);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

logo_image = Image("logo.png");
if (logo_image) {
  logo_sprite = Sprite(logo_image);
  logo_sprite.SetX(screen_w / 2 - logo_image.GetWidth() / 2);
  logo_sprite.SetY(screen_h / 2 - logo_image.GetHeight() / 2 - 40);
} else {
  title_image = Image.Text("MfiSerli OS", 0.88, 0.95, 1.0, 1.0, "Sans Bold 28");
  title_sprite = Sprite(title_image);
  title_sprite.SetX(screen_w / 2 - title_image.GetWidth() / 2);
  title_sprite.SetY(screen_h / 2 - 45);
}

# Minimal teal progress bar
bar_w = 260;
bar_h = 6;
bar_x = screen_w / 2 - bar_w / 2;
bar_y = screen_h / 2 + 70;

progress_ratio = 0.15;

fun boot_progress_callback(duration, progress) {
  progress_ratio = progress;
  pct = Math.Int(progress * 100);
  status_img = Image.Text("Запуск MfiSerli OS... " + pct + "%", 0.55, 0.85, 0.93, 1.0, "Sans 11");
  status_sprite = Sprite(status_img);
  status_sprite.SetX(screen_w / 2 - status_img.GetWidth() / 2);
  status_sprite.SetY(bar_y);
}

Plymouth.SetBootProgressFunction(boot_progress_callback);
